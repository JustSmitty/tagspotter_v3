<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CAPACITOR_DEBUG</key>
	<string>$(CAPACITOR_DEBUG)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>Tag Spotter</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Declared here so App Store Connect stops asking the export-compliance
	     question on every single build upload. Tag Spotter ships no encryption of
	     its own: the save file is plain JSON (dec-0009) and the only cryptography
	     in the app is the HTTPS the platform provides, which is exempt. Adding
	     encryption beyond that means revisiting this key, not deleting it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Tag Spotter uses your location when you mark a plate as found to award distance bonus points. Your coordinates are not stored.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- arm64, not Capacitor's scaffolded armv7. The deployment target is iOS 15,
	     which no 32-bit device can run, so the binary contains no armv7 slice at
	     all: the scaffold default declared a requirement the app does not ship
	     and could not satisfy. Every device capable of installing this app is
	     arm64, so the honest value is the one the binary actually has. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<!-- iPhone only (TARGETED_DEVICE_FAMILY = 1), so there is deliberately no
	     ~ipad variant of this key: on an iPad the app runs in iPhone
	     compatibility mode and uses the list below. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
</dict>
</plist>

